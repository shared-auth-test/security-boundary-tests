    {"from": "stepUpRequired", "event": "startStepUp", "to": "steppingUp", "effect": "retainCredential"},
    {"from": "stepUpRequired", "event": "startRefresh", "to": "refreshing", "effect": "retainCredential"},
    {"from": "stepUpRequired", "event": "transientFailure", "to": "degraded", "effect": "retainCredential"},
    {"from": "stepUpRequired", "event": "cancel", "to": "authenticated", "effect": "retainCredential"},
    {"from": "stepUpRequired", "event": "startSignOut", "to": "signingOut", "effect": "retainCredential"},
    {"from": "stepUpRequired", "event": "detectCredentialCorruption", "to": "locked", "effect": "clearCredential"},

    {"from": "steppingUp", "event": "stepUpSucceeded", "to": "authenticatedAal2", "effect": "retainCredential"},
    {"from": "steppingUp", "event": "stepUpRejected", "to": "stepUpRequired", "effect": "retainCredential"},
    {"from": "steppingUp", "event": "transientFailure", "to": "stepUpRequired", "effect": "retainCredential"},
    {"from": "steppingUp", "event": "cancel", "to": "authenticated", "effect": "retainCredential"},
    {"from": "steppingUp", "event": "startSignOut", "to": "signingOut", "effect": "retainCredential"},
    {"from": "steppingUp", "event": "detectCredentialCorruption", "to": "locked", "effect": "clearCredential"},

    {"from": "authenticatedAal2", "event": "startRefresh", "to": "refreshing", "effect": "retainCredential"},
