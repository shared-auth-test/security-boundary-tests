{
  "bugs": {
    "url": "https://github.com/shared-auth/shared-auth-clients/issues"
  },
  "description": "Hardened typed clients for the shared-auth server HTTP API.",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bun": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./delegation": {
      "types": "./dist/delegation.d.ts",
      "import": "./dist/delegation.js"
    },
    "./deno": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./edge": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nodejs": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle.d.ts",
      "import": "./dist/lifecycle.js"
    },
    "./reactive": {
      "types": "./dist/auth_lifecycle_rx.d.ts",
      "import": "./dist/auth_lifecycle_rx.js"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/shared-auth/shared-auth-clients#readme",
  "license": "MIT",
  "main": "dist/index.js",
  "name": "@shared-auth/client",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shared-auth/shared-auth-clients.git",
    "directory": "clients/ts"
  },
  "scripts": {
    "test:contract": "python3 ../../contract/bin/check_surface.py --lang ts",
    "pretest": "python3 ../../contract/bin/check_surface.py --lang ts",
    "prepublishOnly": "npm run lint:ores && python3 ../../contract/bin/check_surface.py --prepublish --lang ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "node ../../scripts/check-auth-lifecycle-ts.mjs && tsc -p tsconfig.json",
    "package:check": "npm run build && node --test test/package.test.mjs",
    "test": "npm run build && node --test test/client.test.mjs test/introspection_service_credential.test.mjs test/delegation.test.mjs test/auth_lifecycle_reactive.test.mjs",
    "test:browser": "npm run build && playwright test --config playwright.config.mjs",
    "lint:ores": "if [ -f ../../.ores-lint/lint.sh ]; then sh ../../.ores-lint/lint.sh; else echo 'ores-lint not installed'; fi",
    "prebuild": "npm run lint:ores"
  },
  "sideEffects": false,
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "0.1.0",
  "oresLint": {
    "note": "Declared, not installed. ores-lint resolves these from a global install - see .ores-lint/README.md",
    "requires": {
      "eslint": ">=9",
      "typescript-eslint": ">=8 (optional; without it .ts files are skipped)"
    },
    "install": "npm i -g eslint typescript-eslint"
  },
  "dependencies": {
    "rxjs": "7.8.2"
  }
}
