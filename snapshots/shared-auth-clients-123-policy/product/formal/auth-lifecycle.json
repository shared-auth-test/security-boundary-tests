    {"from": "authenticatedAal2", "event": "startSignOut", "to": "signingOut", "effect": "retainCredential"},
    {"from": "authenticatedAal2", "event": "detectCredentialCorruption", "to": "locked", "effect": "clearCredential"},

    {"from": "degraded", "event": "recover", "to": "refreshing", "effect": "retainCredential"},
    {"from": "degraded", "event": "startSignOut", "to": "signingOut", "effect": "retainCredential"},
    {"from": "degraded", "event": "detectCredentialCorruption", "to": "locked", "effect": "clearCredential"},

    {"from": "signingOut", "event": "signOutSucceeded", "to": "signedOut", "effect": "clearCredential"},
    {"from": "signingOut", "event": "signOutFailed", "to": "signedOut", "effect": "clearCredentialAndRetryRevocation"},
