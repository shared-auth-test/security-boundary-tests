# Credential-free client SDK example/conformance profile.
SHARED_AUTH_BASE_URL=http://127.0.0.1:8120
SHARED_AUTH_TIMEOUT_MS=10000
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_RESOURCE_ATTRIBUTES=service.name=shared-auth-client-tests,deployment.environment=local

# User/session credentials come from the invoking application or disposable E2E
# harness. This repository must not own provider, service-role, signing, database,
# refresh-token, reusable bearer-token, SendGrid, or Twilio credentials.
